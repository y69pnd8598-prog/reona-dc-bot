name: Clean Old Runs

on:
  workflow_dispatch:

permissions:
  actions: write

jobs:
  clean:
    runs-on: ubuntu-latest
    steps:
      - name: Delete old workflow runs
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh run list --repo "${{ github.repository }}" --limit 400 --json databaseId --jq '.[2:].[].databaseId' | xargs -I {} gh run delete {} --repo "${{ github.repository }}"
